FROM python:3.12-slim

WORKDIR /app

COPY service/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY stubs/python /app/stubs/python
COPY service /app/service

ENV PYTHONPATH=/app/stubs/python:/app/service
ENV SAHIIXX_DB=/data/sahiixx_revenue.db

WORKDIR /app/service
EXPOSE 8080

# Port configurable via PORT (default 8080) so hosts that inject PORT (Fly, some PaaS)
# bind correctly; docker-compose keeps the 8080 default.
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8080}"]
